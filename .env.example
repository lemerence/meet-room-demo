# Docker local application configuration; copy to .env.local and supply a password.
DB_URL=jdbc:mysql://host.docker.internal:3306/meet_room?connectionTimeZone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=meet_room
DB_PASSWORD=
# Tests use these independent values and never fall back to DB_*.
TEST_DB_HOST=host.docker.internal
TEST_DB_PORT=3306
TEST_DB_PASSWORD=
